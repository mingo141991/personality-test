.archetype {
  margin-top: 18rpx;
  color: #2f3430;
  font-size: 30rpx;
  font-weight: 800;
}

.summary {
  margin-top: 18rpx;
  color: #667066;
  font-size: 28rpx;
  line-height: 1.7;
}

.stress-score-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
}

.stress-score {
  margin-top: 0;
  color: #c68873;
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1;
}

.stress-unit {
  margin-top: 8rpx;
  color: #9b8f86;
  font-size: 24rpx;
  font-weight: 800;
}

.stress-level-pill {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #9b6f63;
  background: #f6eadf;
  font-size: 24rpx;
  font-weight: 900;
}

.stress-index-track {
  overflow: hidden;
  height: 22rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #efe5da;
}

.stress-index-fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6f9a7b 0%, #7a9ab0 38%, #c99a58 70%, #c68873 100%);
}

.visual-note {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  color: #667066;
  background: rgba(111, 143, 116, 0.08);
  font-size: 26rpx;
  line-height: 1.65;
}

.bars,
.dimension-report,
.stress-report,
.share-card,
.unlock,
.advice,
.detail,
.next-card,
.empty-card {
  padding: 30rpx;
}

.section-title {
  color: #5f7d66;
  font-size: 32rpx;
  font-weight: 800;
}

.section-subtitle {
  margin-top: 12rpx;
  color: #7f877f;
  font-size: 25rpx;
  line-height: 1.65;
}

.bar-item {
  margin-top: 26rpx;
}

.bar-label {
  display: flex;
  justify-content: space-between;
  color: #6b746b;
  font-size: 24rpx;
  font-weight: 700;
}

.winner {
  color: #c68873;
}

.bar-track {
  display: flex;
  overflow: hidden;
  height: 18rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: #efe5da;
}

.bar-left {
  background: #c68873;
}

.bar-right {
  background: #6f8f74;
}

.stress-item {
  margin-top: 28rpx;
}

.stress-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.report-copy {
  min-width: 0;
}

.stress-name {
  color: #2f3430;
  font-size: 30rpx;
  font-weight: 900;
}

.stress-desc {
  margin-top: 8rpx;
  color: #667066;
  font-size: 25rpx;
  line-height: 1.55;
}

.stress-track {
  margin-top: 16rpx;
}

.share-actions {
  gap: 12rpx;
  margin-top: 24rpx;
}

.share-btn {
  min-width: 0;
  width: 100%;
  min-height: 78rpx;
  padding: 0 16rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  line-height: 1.15;
}

.report-item {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(92, 116, 96, 0.12);
}

.report-item:first-of-type {
  border-top: none;
}

.report-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.report-title {
  color: #2f3430;
  font-size: 30rpx;
  font-weight: 800;
}

.report-axis {
  margin-top: 8rpx;
  color: #8b8179;
  font-size: 24rpx;
  font-weight: 700;
}

.report-badge {
  flex: 0 0 auto;
  max-width: 188rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #9b6f63;
  background: #f6eadf;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
  text-align: center;
  overflow-wrap: break-word;
  word-break: break-word;
}

.report-text {
  margin-top: 16rpx;
  color: #606860;
  font-size: 27rpx;
  line-height: 1.7;
}

.meaning-grid {
  gap: 14rpx;
  margin-top: 18rpx;
}

.meaning-cell {
  box-sizing: border-box;
  min-width: 0;
  min-height: 164rpx;
  padding: 18rpx;
  border: 2rpx solid rgba(111, 143, 116, 0.1);
  border-radius: 20rpx;
  background: rgba(255, 252, 246, 0.7);
}

.meaning-active {
  border-color: rgba(111, 143, 116, 0.34);
  background: #edf4ec;
}

.meaning-name {
  color: #405a45;
  font-size: 25rpx;
  font-weight: 800;
  overflow-wrap: break-word;
  word-break: break-word;
}

.meaning-text {
  margin-top: 10rpx;
  color: #667066;
  font-size: 24rpx;
  line-height: 1.55;
  overflow-wrap: break-word;
  word-break: break-word;
}

.unlock-text,
.empty-text {
  margin: 18rpx 0 28rpx;
  color: #667066;
  font-size: 28rpx;
  line-height: 1.7;
}

.full-result {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.advice-grid {
  gap: 16rpx;
  margin-top: 24rpx;
}

.advice-block {
  box-sizing: border-box;
  min-width: 0;
  min-height: 220rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: rgba(246, 234, 223, 0.72);
}

.stress-advice-grid {
  grid-template-columns: 1fr;
}

.stress-advice-block {
  min-height: auto;
}

.advice-title {
  color: #5f7d66;
  font-size: 26rpx;
  font-weight: 900;
  overflow-wrap: break-word;
  word-break: break-word;
}

.advice-line {
  position: relative;
  margin-top: 14rpx;
  padding-left: 20rpx;
  color: #606860;
  font-size: 24rpx;
  line-height: 1.55;
  overflow-wrap: break-word;
  word-break: break-word;
}

.advice-line::before {
  content: "";
  position: absolute;
  top: 15rpx;
  left: 0;
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #c68873;
}

.detail-line {
  position: relative;
  margin-top: 18rpx;
  padding-left: 26rpx;
  color: #606860;
  font-size: 28rpx;
  line-height: 1.65;
  overflow-wrap: break-word;
  word-break: break-word;
}

.detail-line::before {
  content: "";
  position: absolute;
  top: 20rpx;
  left: 0;
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #c68873;
}

.result-actions {
  gap: 12rpx;
  margin-top: 24rpx;
}

.result-action-btn {
  min-width: 0;
  width: 100%;
  min-height: 78rpx;
  padding: 0 16rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  line-height: 1.15;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(47, 52, 48, 0.32);
}

.modal {
  padding: 36rpx 30rpx 28rpx;
}

.modal-title {
  color: #2f3430;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
}

.modal-text {
  margin-top: 18rpx;
  color: #667066;
  font-size: 28rpx;
  line-height: 1.7;
  text-align: center;
}

.countdown {
  margin-top: 28rpx;
  color: #6f8f74;
  font-size: 56rpx;
  font-weight: 900;
  text-align: center;
}

.modal-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 28rpx;
}

.poster-modal {
  max-height: 88vh;
  padding: 30rpx;
}

.poster-preview {
  display: block;
  width: 100%;
  height: 680rpx;
  margin-top: 24rpx;
  border-radius: 24rpx;
  background: #fbf7f0;
}

.poster-actions {
  gap: 12rpx;
  margin-top: 22rpx;
}

.poster-actions .primary-btn,
.poster-actions .secondary-btn {
  min-width: 0;
  width: 100%;
  min-height: 78rpx;
  padding: 0 16rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  line-height: 1.15;
}

.poster-canvas {
  position: fixed;
  top: -9999px;
  left: -9999px;
  width: 375px;
  height: 500px;
  pointer-events: none;
}
