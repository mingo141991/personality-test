.result-page,
.empty-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.result-card {
  overflow: hidden;
  padding: 36rpx 32rpx;
}

.result-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.result-copy {
  min-width: 0;
}

.label {
  color: #c68873;
  font-size: 24rpx;
  font-weight: 700;
}

.type {
  margin-top: 18rpx;
  color: #405a45;
  font-size: 78rpx;
  font-weight: 900;
  line-height: 1;
}

.nickname {
  margin-top: 18rpx;
  color: #2f3430;
  font-size: 36rpx;
  font-weight: 800;
}

.role-pill {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #6f8f74;
  font-size: 24rpx;
  font-weight: 700;
}

.avatar-wrap {
  position: relative;
  flex: 0 0 224rpx;
  width: 224rpx;
  height: 256rpx;
}

.avatar-aura {
  position: absolute;
  right: 0;
  bottom: 10rpx;
  width: 208rpx;
  height: 208rpx;
  border-radius: 72rpx;
  background: #e7f3ea;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.62), 0 18rpx 34rpx rgba(86, 74, 54, 0.1);
  transform: rotate(8deg);
}

.avatar-orbit {
  position: absolute;
  right: 18rpx;
  top: 22rpx;
  width: 168rpx;
  height: 168rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 54rpx;
  transform: rotate(-18deg);
}

.avatar-orbit::before,
.avatar-orbit::after {
  content: "";
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
}

.avatar-orbit::before {
  top: 16rpx;
  right: 22rpx;
  width: 16rpx;
  height: 16rpx;
}

.avatar-orbit::after {
  left: 20rpx;
  bottom: 18rpx;
  width: 10rpx;
  height: 10rpx;
}

.avatar-person {
  position: absolute;
  left: 22rpx;
  bottom: 0;
  width: 170rpx;
  height: 236rpx;
}

.avatar-head {
  position: absolute;
  left: 40rpx;
  top: 14rpx;
  z-index: 4;
  width: 92rpx;
  height: 94rpx;
  border-radius: 42rpx 42rpx 34rpx 34rpx;
  background: #f2c8ae;
  box-shadow: inset -8rpx -10rpx 0 rgba(143, 99, 81, 0.08), 0 6rpx 0 rgba(116, 82, 72, 0.08);
}

.avatar-hair {
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  width: 108rpx;
  height: 50rpx;
  border-radius: 52rpx 48rpx 26rpx 18rpx;
  background: #504844;
  box-shadow: 14rpx 12rpx 0 -6rpx rgba(67, 58, 54, 0.9);
}

.avatar-hair::before,
.avatar-hair::after {
  content: "";
  position: absolute;
  background: inherit;
}

.avatar-hair::before {
  left: 8rpx;
  top: 26rpx;
  width: 26rpx;
  height: 44rpx;
  border-radius: 999rpx;
  transform: rotate(12deg);
}

.avatar-hair::after {
  right: 8rpx;
  top: 22rpx;
  width: 24rpx;
  height: 38rpx;
  border-radius: 999rpx;
  transform: rotate(-14deg);
}

.avatar-face {
  position: absolute;
  left: 24rpx;
  top: 50rpx;
  display: flex;
  gap: 20rpx;
}

.avatar-eye {
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #453f3b;
  box-shadow: 0 16rpx 0 -3rpx rgba(155, 92, 74, 0.32);
}

.avatar-body {
  position: absolute;
  left: 24rpx;
  top: 100rpx;
  z-index: 2;
  width: 124rpx;
  height: 126rpx;
  border-radius: 48rpx 48rpx 30rpx 30rpx;
  background: #6f8f74;
  box-shadow: inset -12rpx -16rpx 0 rgba(49, 74, 53, 0.1), 0 12rpx 24rpx rgba(86, 74, 54, 0.12);
}

.avatar-body::before,
.avatar-body::after {
  content: "";
  position: absolute;
  top: 24rpx;
  width: 34rpx;
  height: 92rpx;
  border-radius: 999rpx;
  background: #52785c;
}

.avatar-body::before {
  left: -18rpx;
  transform: rotate(13deg);
}

.avatar-body::after {
  right: -18rpx;
  transform: rotate(-13deg);
}

.avatar-collar {
  position: absolute;
  left: 62rpx;
  top: 102rpx;
  z-index: 5;
  width: 48rpx;
  height: 26rpx;
  border-radius: 0 0 18rpx 18rpx;
  background: #fff7ee;
}

.avatar-collar::before,
.avatar-collar::after {
  content: "";
  position: absolute;
  top: 0;
  width: 28rpx;
  height: 30rpx;
  border-radius: 8rpx;
  background: #fff7ee;
}

.avatar-collar::before {
  left: -18rpx;
  transform: skewY(24deg);
}

.avatar-collar::after {
  right: -18rpx;
  transform: skewY(-24deg);
}

.avatar-cape {
  position: absolute;
  left: 14rpx;
  top: 96rpx;
  z-index: 1;
  width: 144rpx;
  height: 132rpx;
  border-radius: 54rpx 54rpx 32rpx 32rpx;
  background: rgba(64, 52, 82, 0.18);
  transform: rotate(3deg);
}

.avatar-prop,
.avatar-detail {
  position: absolute;
  z-index: 6;
}

.avatar-detail {
  left: 70rpx;
  top: 150rpx;
  width: 32rpx;
  height: 42rpx;
  border-radius: 999rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.68);
  background: rgba(255, 255, 255, 0.18);
}

