.quiz-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.progress-wrap {
  padding: 8rpx 4rpx 0;
}

.progress-text {
  color: #6f8f74;
  font-size: 28rpx;
  font-weight: 700;
}

.progress-track {
  overflow: hidden;
  height: 14rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #efe5da;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #6f8f74;
  transition: width 0.2s ease;
}

.question-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  height: 390rpx;
  padding: 34rpx 30rpx;
}

.question-id {
  align-self: flex-start;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #9b6f63;
  background: #f6eadf;
  font-size: 24rpx;
  font-weight: 800;
}

.question-body {
  box-sizing: border-box;
  flex: 1;
  min-height: 0;
  width: 100%;
  margin-top: 20rpx;
}

.statement {
  color: #333a35;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.48;
}

.divider {
  margin-top: 24rpx;
  color: #9b8f86;
  font-size: 24rpx;
  text-align: center;
}

.scale-prompt {
  color: #c68873;
  font-size: 24rpx;
  font-weight: 800;
}

.scale-statement {
  margin-top: 24rpx;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.option {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  border: 2rpx solid rgba(111, 143, 116, 0.16);
  border-radius: 24rpx;
  color: #59625a;
  background: rgba(255, 252, 246, 0.86);
  font-size: 28rpx;
  text-align: left;
}

.option-active {
  border-color: #6f8f74;
  color: #405a45;
  background: #edf4ec;
  font-weight: 700;
}

.actions {
  gap: 18rpx;
  margin-top: 8rpx;
}

.nav-btn {
  min-width: 0;
  min-height: 92rpx;
  padding: 0 12rpx;
  font-size: 28rpx;
}

.reset-btn {
  min-height: 72rpx;
  color: #9b6f63;
  font-size: 26rpx;
}
